# Server (.env) - copy to .env and fill in. Never commit .env.
# Challenge-binding secret: openssl rand -base64 32
MPP_SECRET_KEY=
# Receiver wallet address (public, 0x...) that gets paid
MPP_RECIPIENT=
# Receiver private key: only needed to move received test funds. Server does NOT use it.
RECEIVER_PRIVATE_KEY=
# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Payer (demo agent) lives in a separate file, .env.payer:
#   MPPX_PRIVATE_KEY=0x...   (read by `npx mppx` instead of the OS keychain)
#   PAYER_ADDRESS=0x...

# AI step: Gemini is used if set (free tier at aistudio.google.com), otherwise Claude
GEMINI_API_KEY=
# Optional: Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=
